{
  "manifest_version": 2,
  "name": "OEB \u2014 Open Exam Browser",
  "description": "Opens SEB configurations and provides optional multi-provider AI autofill for Moodle questions.",
  "version": "2.5.0",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_title": "OEB \u2014 Open Exam Browser",
    "default_popup": "popup.html"
  },
  "commands": {
    "answer-questions": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Ask AI providers and fill questions on the active page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-api.js",
        "assistant/extract.js",
        "assistant/apply.js",
        "assistant/content.js",
        "seb/download-content.js",
        "seb/content.js"
      ],
      "css": [
        "seb/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "seb/assets/startup.html",
    "seb/assets/taskbar.html",
    "seb/assets/colors.css",
    "seb/assets/startup.js",
    "seb/assets/taskbar.js",
    "seb/assets/quit.html",
    "seb/assets/quit.css",
    "seb/assets/quit.js",
    "seb/icons/SebSplashScreen.png",
    "seb/icons/seb_logo.png",
    "seb/icons/aero_arrow.cur",
    "seb/icons/shutdown.svg",
    "seb/icons/wifi.svg",
    "seb/download-page.js",
    "seb/icons/aero_beam.cur",
    "seb/icons/aero_busy.ani",
    "seb/icons/aero_busy.cur",
    "seb/icons/aero_cross.cur",
    "seb/icons/aero_ew.cur",
    "seb/icons/aero_helpsel.cur",
    "seb/icons/aero_link.cur",
    "seb/icons/aero_move.cur",
    "seb/icons/aero_nesw.cur",
    "seb/icons/aero_ns.cur",
    "seb/icons/aero_nwse.cur",
    "seb/icons/aero_pen.cur",
    "seb/icons/aero_unavail.cur",
    "seb/icons/aero_up.cur",
    "seb/icons/aero_working.ani",
    "seb/icons/aero_working.cur",
    "seb/icons/aero_arrow.png",
    "seb/icons/aero_beam.png",
    "seb/icons/aero_busy.png",
    "seb/icons/aero_cross.png",
    "seb/icons/aero_ew.png",
    "seb/icons/aero_helpsel.png",
    "seb/icons/aero_link.png",
    "seb/icons/aero_move.png",
    "seb/icons/aero_nesw.png",
    "seb/icons/aero_ns.png",
    "seb/icons/aero_nwse.png",
    "seb/icons/aero_pen.png",
    "seb/icons/aero_unavail.png",
    "seb/icons/aero_up.png",
    "seb/icons/aero_working.png"
  ],
  "minimum_chrome_version": "111"
}

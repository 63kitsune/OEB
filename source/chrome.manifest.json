{
  "manifest_version": 2,
  "name": "OEB — Open Exam Browser",
  "description": "Opens SEB configurations and provides optional multi-provider AI autofill for Moodle questions.",
  "version": "2.3.4",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_title": "OEB — Open Exam Browser",
    "default_popup": "popup.html"
  },
  "commands": {
    "answer-questions": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Ask AI providers and fill questions on the active page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-api.js",
        "assistant/extract.js",
        "assistant/apply.js",
        "assistant/content.js",
        "seb/content.js"
      ],
      "css": [
        "seb/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "seb/assets/startup.html",
    "seb/assets/taskbar.html",
    "seb/assets/colors.css",
    "seb/assets/startup.js",
    "seb/assets/taskbar.js",
    "seb/assets/quit.html",
    "seb/assets/quit.css",
    "seb/assets/quit.js",
    "seb/icons/SebSplashScreen.png",
    "seb/icons/seb_logo.png",
    "seb/icons/shutdown.svg",
    "seb/icons/wifi.svg"
  ],
  "minimum_chrome_version": "88"
}
